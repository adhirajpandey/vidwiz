# Docker Compose database configuration
POSTGRES_USER=vidwiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vidwiz

# Application startup requirements
ENVIRONMENT=local
DB_URL=postgresql+psycopg2://vidwiz:change-me@database:5432/vidwiz
SECRET_KEY=replace-with-a-long-random-secret
VIDWIZ_INTERNAL_API_ADMIN_TOKEN=replace-with-an-internal-admin-token
GOOGLE_CLIENT_ID=replace-with-google-client-id
SQS_AI_NOTE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/vidwiz-v3-ai-note-jobs
AWS_ACCESS_KEY_ID=replace-with-application-access-key
AWS_SECRET_ACCESS_KEY=replace-with-application-secret-key
AWS_REGION=ap-south-1
DODO_PAYMENTS_API_KEY=replace-with-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=replace-with-dodo-webhook-key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:5173/profile
DODO_CREDIT_PRODUCTS=[]

# Optional application integrations
S3_TRANSCRIPT_BUCKET_NAME=
OPENROUTER_API_KEY=
WIZ_MODEL=minimax/minimax-m2.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VIDWIZ_INTERNAL_API_BASE_URL=http://localhost:5000

# Optional application tuning
JWT_EXPIRY_HOURS=168
WIZ_USER_DAILY_QUOTA=20
WIZ_GUEST_DAILY_QUOTA=5
WIZ_MAX_TOKENS=8192

# Library Ask: query expansion model, candidate and source limits, and Jev
# relevance scoring through OpenRouter (pin a dated Jev version).
ASK_QUERY_MODEL=z-ai/glm-5.3-flash
ASK_CANDIDATES=48
ASK_MAX_SOURCES=8
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.14-20261014
JEV_RELEVANCE_THRESHOLD=0.5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CONVERSATIONS=20/minute
RATE_LIMIT_VIDEOS=30/minute
SIGNUP_GRANT_AMOUNT=100
WIZ_CHAT_COST=5
AI_MOMENT_COST=1
LOG_LEVEL=INFO
LOG_SERVICE_NAME=vidwiz-api
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
