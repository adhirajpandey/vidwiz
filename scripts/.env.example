# Services (API base includes /v2)
VIDWIZ_UI_BASE_URL=http://localhost:5174
VIDWIZ_API_BASE_URL=http://localhost:5000/v2

# Dedicated test account, never a personal account
VIDWIZ_AUTOMATION_EMAIL=
VIDWIZ_AUTOMATION_PASSWORD=

# Saved video with moments, a ready transcript, and a completed overview
VIDWIZ_AUTOMATION_VIDEO_ID=
# A word present in the test library (at least two characters)
VIDWIZ_AUTOMATION_SEARCH_QUERY=learning
# Only --pages ask-answer sends this question, once per invocation
VIDWIZ_AUTOMATION_ASK_PROMPT=What practical advice do my saved videos give about learning a new skill? Give a concise answer with citations.

# Screenshot behavior (dark by default; override with --themes dark light)
VIDWIZ_UI_IMAGE_OUTPUT_DIR=scripts/outputs/ui-images
VIDWIZ_AUTOMATION_NAVIGATION_TIMEOUT_MS=30000
VIDWIZ_AUTOMATION_SCROLL_OVERLAP_PX=140
VIDWIZ_AUTOMATION_POST_SCROLL_SETTLE_MS=400
VIDWIZ_AUTOMATION_MAX_SCREENSHOTS_PER_PAGE=30
