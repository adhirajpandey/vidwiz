# Local VidWiz services
VIDWIZ_UI_BASE_URL=http://localhost:5173
VIDWIZ_API_BASE_URL=http://localhost:5000/v2

# Existing local automation account
VIDWIZ_AUTOMATION_EMAIL=
VIDWIZ_AUTOMATION_PASSWORD=

# Existing video with metadata and transcript ready
VIDWIZ_AUTOMATION_VIDEO_ID=

# Screenshot behavior
VIDWIZ_UI_IMAGE_OUTPUT_DIR=scripts/outputs/ui-images
VIDWIZ_AUTOMATION_NAVIGATION_TIMEOUT_MS=30000
VIDWIZ_AUTOMATION_SCROLL_OVERLAP_PX=140
VIDWIZ_AUTOMATION_POST_SCROLL_SETTLE_MS=400
VIDWIZ_AUTOMATION_MAX_SCREENSHOTS_PER_PAGE=20
